@model Enhartt.MVC.Models.ViewModels.RecetasViewModel

@{
    ViewData["Title"] = "Gestión de Recetas";
}

<!-- 1. Selector de Celda y Salida (Filtros Superiores) -->
<div class="row g-2 mb-3 align-items-end">
    <div class="col-md-4">
        <div class="bg-white px-3 py-2 rounded-2 border border-light-subtle shadow-sm">
            <label class="form-label text-secondary fw-semibold mb-0 d-flex align-items-center" style="font-size: 0.75rem;">
                <i class="bi bi-cpu-fill text-primary me-1"></i>Seleccionar Celda
            </label>
            <select id="selectCelda" class="form-select form-select-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0" style="font-size: 0.85rem;">
                <option value="">-- Seleccione una Celda --</option>
                @if (Model?.Celdas != null)
                {
                    foreach (var celda in Model.Celdas)
                    {
                        <option value="@celda.Celda">@celda.Celda</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="col-md-4">
        <div class="bg-white px-3 py-2 rounded-2 border border-light-subtle shadow-sm">
            <label class="form-label text-secondary fw-semibold mb-0 d-flex align-items-center" style="font-size: 0.75rem;">
                <i class="bi bi-crosshair text-info me-1"></i>Seleccionar Salida / Pistola
            </label>
            <select id="selectSalida" class="form-select form-select-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0" style="font-size: 0.85rem;" disabled>
                <option value="">-- Seleccione una Celda Primero --</option>
            </select>
        </div>
    </div>

    <div class="col-md-4">
        <div class="px-3 py-2 rounded-2 border shadow-sm d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); height: 48px; border-color: #334155 !important;">
            <span class="text-white-50 fw-semibold d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                <i class="bi bi-clock-history text-info"></i>Última Modificación:
            </span>
            <span id="lblUltimaMod" class="badge rounded-pill bg-dark border border-secondary text-info font-monospace" style="font-size: 0.75rem;">N/A</span>
        </div>
    </div>
</div>

<!-- Sección 1: Tabla de Límites de Calidad -->
<div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden" style="background: #ffffff; border: 1px solid #e2e8f0; border-top: 3px solid #0284c7 !important;">
    <div class="card-header border-0 px-3 py-2 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="d-flex align-items-center gap-2">
            <div class="p-1 px-2 rounded-2 d-flex align-items-center justify-content-center" style="background: rgba(14, 165, 233, 0.2); border: 1px solid rgba(14, 165, 233, 0.4);">
                <i class="bi bi-sliders text-info fs-6"></i>
            </div>
            <div>
                <span class="fw-bold small text-white d-block lh-1" style="letter-spacing: 0.3px;">Límites de Calidad (Parámetros Físicos)</span>
                <span class="d-block mt-1" style="font-size: 0.73rem; color: #94a3b8;">Configuración de tolerancias para la celda y salida activa</span>
            </div>
        </div>
        <button id="btnGuardarCambios" class="btn btn-sm btn-success fw-bold px-3 py-1 shadow-sm d-flex align-items-center gap-1 border-0" 
                style="background: linear-gradient(135deg, #10b981, #059669); font-size: 0.78rem;" disabled>
            <i class="bi bi-floppy-fill"></i>
            <span>Guardar Cambios</span>
        </button>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0 text-nowrap" style="font-size: 0.85rem;">
                <thead>
                    <tr class="text-uppercase" style="font-size: 0.74rem; letter-spacing: 0.5px;">
                        <th class="py-2 ps-3 bg-dark text-white-50">Parámetro</th>
                        <th class="py-2 bg-dark text-white-50">Unidad</th>
                        <th class="py-2 bg-dark text-white-50">Límite Mínimo (Min)</th>
                        <th class="py-2 bg-dark text-white-50">Límite Máximo (Max)</th>
                        <th class="py-2 bg-dark text-white-50">Fecha Último Cambio</th>
                        <th class="py-2 bg-dark text-white-50">Usuario</th>
                        <th class="py-2 pe-3 bg-dark text-white-50 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody id="tblLimitesBody" class="border-top-0">
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No hay parámetros configurados para la combinación seleccionada.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Sección 2: Historial de Cambios y Auditoría con Bitácora -->
<div class="card border-0 shadow-sm rounded-3 mb-3 overflow-hidden" style="background: #ffffff; border: 1px solid #e2e8f0; border-top: 3px solid #f59e0b !important;">
    <div class="card-header border-0 px-3 py-2 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="d-flex align-items-center gap-2">
            <div class="p-1 px-2 rounded-2 d-flex align-items-center justify-content-center" style="background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.4);">
                <i class="bi bi-clock-history text-warning fs-6"></i>
            </div>
            <div>
                <span class="fw-bold small text-white d-block lh-1" style="letter-spacing: 0.3px;">Historial de Cambios y Bitácora de Mantenimiento</span>
                <span class="d-block mt-1" style="font-size: 0.73rem; color: #94a3b8;">Trazabilidad de modificaciones de recetas y motivos operativos</span>
            </div>
        </div>
    </div>

    <div class="card-body p-3">
        <form id="formAuditoria" class="row g-2 mb-3 align-items-end">
            <div class="col-md-4">
                <div class="bg-white px-2 py-1 rounded-2 border border-light-subtle shadow-sm">
                    <label class="form-label text-secondary fw-semibold mb-0 d-flex align-items-center" style="font-size: 0.72rem;">
                        <i class="bi bi-calendar-event-fill text-info me-1"></i>Fecha Inicio
                    </label>
                    <input type="date" id="fechaInicio" class="form-control form-control-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0" style="font-size: 0.82rem;">
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white px-2 py-1 rounded-2 border border-light-subtle shadow-sm">
                    <label class="form-label text-secondary fw-semibold mb-0 d-flex align-items-center" style="font-size: 0.72rem;">
                        <i class="bi bi-calendar-check-fill text-info me-1"></i>Fecha Fin
                    </label>
                    <input type="date" id="fechaFin" class="form-control form-control-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0" style="font-size: 0.82rem;">
                </div>
            </div>
            <div class="col-md-4">
                <button type="button" id="btnConsultarAuditoria" class="btn btn-primary w-100 rounded-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-1 border-0" 
                        style="background: linear-gradient(135deg, #0284c7, #0369a1); height: 38px; font-size: 0.82rem;">
                    <i class="bi bi-search"></i>
                    <span>Consultar Auditoría</span>
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered text-center align-middle mb-0" style="font-size: 0.82rem;">
                <thead style="background-color: #0f172a; color: #f8fafc;">
                    <tr class="text-uppercase" style="font-size: 0.72rem;">
                        <th class="py-2 bg-dark text-white-50">Fecha / Hora</th>
                        <th class="py-2 bg-dark text-white-50">Celda / Salida</th>
                        <th class="py-2 bg-dark text-white-50">Parámetro</th>
                        <th class="py-2 bg-dark text-white-50">Límites Guardados (Mín | Máx)</th>
                        <th class="py-2 bg-dark text-white-50">Estatus Registro</th>
                        <th class="py-2 bg-dark text-white-50">Usuario</th>
                        <th class="py-2 bg-dark text-white-50">Motivo / Bitácora</th>
                        <th class="py-2 bg-dark text-white-50">Acción</th>
                    </tr>
                </thead>
                <tbody id="tblAuditoriaBody">
                    <tr>
                        <td colspan="8" class="text-center text-muted py-3">
                            Selecciona un rango de fechas y presiona "Consultar Auditoría".
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Confirmación Guardar con Bitácora de Mantenimiento -->
<div class="modal fade" id="modalConfirmarGuardar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="modal-header border-0 px-3 py-2 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-bottom: 2px solid #0284c7 !important;">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-1 px-2 rounded-2" style="background: rgba(14, 165, 233, 0.2); border: 1px solid rgba(14, 165, 233, 0.4);">
                        <i class="bi bi-journal-text text-info fs-6"></i>
                    </div>
                    <h6 class="modal-title small fw-bold mb-0 text-white">Confirmar Modificación y Bitácora</h6>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 bg-light bg-opacity-50">
                <p class="mb-2 text-dark small fw-bold">¿Estás seguro de guardar los nuevos límites de calidad?</p>
                
                <div class="bg-white p-2 rounded-2 border border-light-subtle shadow-sm mb-3">
                    <label for="txtMotivoCambio" class="form-label text-secondary fw-semibold mb-1 d-flex align-items-center" style="font-size: 0.75rem;">
                        <i class="bi bi-chat-left-dots-fill text-primary me-1"></i>Motivo del Cambio / Bitácora de Mantenimiento:
                    </label>
                    <textarea id="txtMotivoCambio" class="form-control form-control-sm border-0 bg-light bg-opacity-50 fw-semibold text-dark shadow-none" rows="3" 
                              style="font-size: 0.82rem;" placeholder="Ej: Ajuste por cambio de lote, calibración de pistola, prueba de penetración..."></textarea>
                    <small class="text-muted d-block mt-1" style="font-size: 0.7rem;">Este comentario quedará firmado y registrado en la auditoría.</small>
                </div>

                <div class="alert alert-warning mb-0 py-2 px-3 rounded-2 d-flex align-items-center gap-2 border-0" style="background: rgba(245, 158, 11, 0.12); color: #b45309; font-size: 0.75rem;">
                    <i class="bi bi-exclamation-triangle-fill fs-6 flex-shrink-0"></i>
                    <span>Esta acción generará una nueva versión activa y desactivará la anterior para mantener la trazabilidad.</span>
                </div>
            </div>
            <div class="modal-footer bg-white border-top px-3 py-2" style="border-color: #e2e8f0 !important;">
                <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal" style="font-size: 0.8rem;">Cancelar</button>
                <button type="button" id="btnConfirmarGuardarFinal" class="btn btn-sm btn-success fw-bold px-3 border-0" 
                        style="background: linear-gradient(135deg, #10b981, #059669); font-size: 0.8rem;">
                    <i class="bi bi-check2-circle me-1"></i>Guardar y Registrar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Comparador Diferencial -->
<div class="modal fade" id="modalCompararRecetas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3 overflow-hidden">
            <div class="modal-header border-0 px-3 py-2 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-bottom: 2px solid #f59e0b !important;">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-1 px-2 rounded-2" style="background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.4);">
                        <i class="bi bi-file-diff-fill text-warning fs-6"></i>
                    </div>
                    <h6 class="modal-title small fw-bold mb-0 text-white">Comparativo Diferencial de Auditoría</h6>
                </div>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 bg-light bg-opacity-50">
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm p-2 bg-white border-start border-3 border-secondary rounded-2 h-100">
                            <small class="text-muted fw-bold d-block text-uppercase" style="font-size: 0.68rem;">Versión Anterior / Referencia</small>
                            <span class="fw-bold mb-0 text-dark small" id="cmp-ant-fecha">Fecha: -</span>
                            <small class="text-muted font-monospace d-block" id="cmp-ant-usr" style="font-size: 0.72rem;">Usuario: -</small>
                            <small class="text-secondary d-block mt-1 fst-italic" id="cmp-ant-motivo" style="font-size: 0.72rem;">Motivo: -</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm p-2 bg-white border-start border-3 border-success rounded-2 h-100">
                            <small class="text-success fw-bold d-block text-uppercase" style="font-size: 0.68rem;">Versión Nueva / Modificada</small>
                            <span class="fw-bold mb-0 text-success small" id="cmp-nue-fecha">Fecha: -</span>
                            <small class="text-muted font-monospace d-block" id="cmp-nue-usr" style="font-size: 0.72rem;">Usuario: -</small>
                            <small class="text-dark fw-semibold d-block mt-1" id="cmp-nue-motivo" style="font-size: 0.72rem;">Motivo: -</small>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle text-center mb-0 bg-white shadow-sm" style="font-size: 0.82rem;">
                        <thead style="background-color: #0f172a; color: #f8fafc;">
                            <tr class="text-uppercase" style="font-size: 0.72rem;">
                                <th class="py-2 bg-dark text-white-50">Parámetro</th>
                                <th class="py-2 bg-dark text-white-50">Mínimo Anterior</th>
                                <th class="py-2 bg-dark text-white-50">Mínimo Nuevo</th>
                                <th class="py-2 bg-dark text-white-50">Máximo Anterior</th>
                                <th class="py-2 bg-dark text-white-50">Máximo Nuevo</th>
                                <th class="py-2 bg-dark text-white-50">Estatus Cambio</th>
                            </tr>
                        </thead>
                        <tbody id="tblComparadorBody">
                            <!-- Inyección dinámica JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-white border-top px-3 py-2" style="border-color: #e2e8f0 !important;">
                <button type="button" class="btn btn-sm btn-secondary fw-bold px-3" data-bs-dismiss="modal" style="font-size: 0.8rem;">Cerrar Comparador</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const celdasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Celdas ?? new List<Enhartt.MVC.Models.ViewModels.CeldaViewModel>()));
        let historialAuditoriaCache = [];

        const selectCelda = document.getElementById('selectCelda');
        const selectSalida = document.getElementById('selectSalida');
        const tblLimitesBody = document.getElementById('tblLimitesBody');
        const btnGuardarCambios = document.getElementById('btnGuardarCambios');
        const lblUltimaMod = document.getElementById('lblUltimaMod');

        const modalConfirmar = new bootstrap.Modal(document.getElementById('modalConfirmarGuardar'));
        const btnConfirmarGuardarFinal = document.getElementById('btnConfirmarGuardarFinal');
        const txtMotivoCambio = document.getElementById('txtMotivoCambio');

        const btnConsultarAuditoria = document.getElementById('btnConsultarAuditoria');
        const tblAuditoriaBody = document.getElementById('tblAuditoriaBody');
        const inputFechaInicio = document.getElementById('fechaInicio');
        const inputFechaFin = document.getElementById('fechaFin');

        // 1. Selector de Celda -> Carga Salidas
        selectCelda.addEventListener('change', function () {
            const celdaNombre = this.value;
            selectSalida.innerHTML = '<option value="">-- Seleccione una Salida / Pistola --</option>';
            selectSalida.disabled = true;
            limpiarTabla();

            if (!celdaNombre) return;

            const celdaEncontrada = celdasData.find(c => (c.Celda || c.celda) === celdaNombre);

            if (celdaEncontrada) {
                const maquinas = celdaEncontrada.Maquinas || celdaEncontrada.maquinas || [];
                let haySalidas = false;

                maquinas.forEach(maquina => {
                    const recetas = maquina.Recetas || maquina.recetas || [];
                    const salidasUnicas = [...new Set(recetas.map(r => String(r.Salida || r.salida)))];

                    salidasUnicas.forEach(numSalida => {
                        if (numSalida && numSalida !== "undefined") {
                            const option = document.createElement('option');
                            option.value = maquina.Id || maquina.id;
                            option.dataset.salida = numSalida;
                            option.textContent = `Salida: ${numSalida} (Máquina: ${maquina.IdMaquina || maquina.idMaquina})`;
                            selectSalida.appendChild(option);
                            haySalidas = true;
                        }
                    });
                });

                if (haySalidas) selectSalida.disabled = false;
            }
        });

        // 2. Selector de Salida -> Carga Parámetros
        selectSalida.addEventListener('change', function () {
            const idMaquina = parseInt(this.value, 10);
            const numSalida = this.options[this.selectedIndex]?.dataset.salida;
            const celdaNombre = selectCelda.value;

            if (!idMaquina || !numSalida || !celdaNombre) {
                limpiarTabla();
                return;
            }

            const celdaObj = celdasData.find(c => (c.Celda || c.celda) === celdaNombre);
            const maquinas = celdaObj?.Maquinas || celdaObj?.maquinas || [];
            const maquinaObj = maquinas.find(m => (m.Id || m.id) === idMaquina);
            const recetas = maquinaObj?.Recetas || maquinaObj?.recetas || [];

            // Filtrar únicamente los parámetros activos de esa salida
            const parametrosEncontrados = recetas.filter(r =>
                String(r.Salida || r.salida) === String(numSalida) &&
                (r.Estado ?? r.estado ?? true)
            );

            if (parametrosEncontrados.length > 0) {
                const fechaRef = parametrosEncontrados[0].FechaModificacion || 
                                 parametrosEncontrados[0].fechaModificacion || 
                                 parametrosEncontrados[0].FechaCreacion || 
                                 parametrosEncontrados[0].fechaCreacion;

                if (lblUltimaMod) {
                    lblUltimaMod.innerText = fechaRef 
                        ? fechaRef.toString().replace('T', ' ').slice(0, 16) 
                        : 'SISTEMA_INICIAL';
                }
            } else {
                if (lblUltimaMod) lblUltimaMod.innerText = 'N/A';
            }

            renderizarTabla(parametrosEncontrados);
        });

        btnGuardarCambios.addEventListener('click', function () {
            if (txtMotivoCambio) txtMotivoCambio.value = '';
            modalConfirmar.show();
        });

        // 3. Confirmación de Guardado con Motivo de Bitácora
        btnConfirmarGuardarFinal.addEventListener('click', async function () {
            const idMaquina = parseInt(selectSalida.value, 10);
            const numSalida = selectSalida.options[selectSalida.selectedIndex]?.dataset.salida;
            const comentarioMotivo = txtMotivoCambio ? txtMotivoCambio.value.trim() : '';

            const filas = tblLimitesBody.querySelectorAll('tr');
            const listaParametros = [];

            filas.forEach(row => {
                const celdaParam = row.cells[0]?.innerText.trim();
                const inputs = row.querySelectorAll('input[type="number"]');

                if (celdaParam && inputs.length === 2) {
                    listaParametros.push({
                        Parametro: celdaParam,
                        MinVal: parseFloat(inputs[0].value) || 0,
                        MaxVal: parseFloat(inputs[1].value) || 0
                    });
                }
            });

            modalConfirmar.hide();
            btnGuardarCambios.disabled = true;

            try {
                const response = await fetch('/Recetas/Guardar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        IdMaquina: idMaquina, 
                        Salida: numSalida, 
                        Comentario: comentarioMotivo,
                        Parametros: listaParametros 
                    })
                });

                const result = await response.json();
                if (result.success) {
                    mostrarNotificacion(result.message, "success");
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    mostrarNotificacion("Error: " + result.message, "danger");
                }
            } catch (e) {
                mostrarNotificacion("Error de conexión al guardar.", "danger");
            } finally {
                btnGuardarCambios.disabled = false;
            }
        });

        // 4. Auditoría
        if (btnConsultarAuditoria) {
            btnConsultarAuditoria.addEventListener('click', async function () {
                const fechaInicio = inputFechaInicio.value;
                const fechaFin = inputFechaFin.value;

                if (!fechaInicio || !fechaFin) {
                    mostrarNotificacion("Selecciona un rango de fechas.", "warning");
                    return;
                }

                const idMaquina = selectSalida && selectSalida.value ? selectSalida.value : '';
                const numSalida = selectSalida && selectSalida.options[selectSalida.selectedIndex]?.dataset.salida 
                    ? selectSalida.options[selectSalida.selectedIndex].dataset.salida 
                    : '';

                btnConsultarAuditoria.disabled = true;
                btnConsultarAuditoria.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Consultando...';

                try {
                    const url = `/Recetas/ObtenerAuditoria?idMaquina=${idMaquina}&salida=${numSalida}&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
                    const response = await fetch(url);
                    const result = await response.json();

                    if (result.success) {
                        renderizarTablaAuditoria(result.data);
                    } else {
                        mostrarNotificacion("Error al obtener auditoría: " + result.message, "danger");
                    }
                } catch (e) {
                    mostrarNotificacion("Error al consultar auditoría.", "danger");
                } finally {
                    btnConsultarAuditoria.disabled = false;
                    btnConsultarAuditoria.innerHTML = '<i class="bi bi-search me-1"></i>Consultar Auditoría';
                }
            });
        }

        function renderizarTablaAuditoria(datos) {
            historialAuditoriaCache = datos || [];
            if (!datos || datos.length === 0) {
                tblAuditoriaBody.innerHTML = `<tr><td colspan="8" class="text-center text-muted py-3">No hay auditoría para el rango de fechas seleccionado.</td></tr>`;
                return;
            }
            tblAuditoriaBody.innerHTML = '';
            datos.forEach((item, index) => {
                const tr = document.createElement('tr');
                const esActivo = item.estado === "ACTIVO";
                tr.innerHTML = `
                    <td class="small font-monospace">${item.fecha}</td>
                    <td><span class="badge bg-secondary">${item.celda || 'General'} / Salida ${item.salida}</span></td>
                    <td class="fw-bold">${item.parametro}</td>
                    <td><code class="text-dark fw-bold">${item.minVal}</code> | <code class="text-dark fw-bold">${item.maxVal}</code></td>
                    <td><span class="badge ${esActivo ? 'bg-success' : 'bg-danger'}">${esActivo ? '🟢 ACTIVO' : '🔴 INACTIVO'}</span></td>
                    <td><span class="badge bg-light text-dark border">${item.usuario}</span></td>
                    <td><small class="text-dark fw-semibold text-start d-inline-block text-truncate" style="max-width: 180px;" title="${item.comentario || '-'}">${item.comentario || '-'}</small></td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-bold" onclick="compararAuditoriaItem(${index})">
                            <i class="bi bi-file-diff me-1"></i>Comparar
                        </button>
                    </td>
                `;
                tblAuditoriaBody.appendChild(tr);
            });
        }

        function compararAuditoriaItem(indexActual) {
            const actual = historialAuditoriaCache[indexActual];
            const anterior = historialAuditoriaCache.slice(indexActual + 1).find(h => h.parametro === actual.parametro && String(h.salida) === String(actual.salida)) || {
                fecha: 'N/A (Registro Inicial)',
                usuario: 'SISTEMA_BASE',
                comentario: 'Sin registro previo',
                minVal: actual.minVal,
                maxVal: actual.maxVal
            };

            document.getElementById('cmp-ant-fecha').innerText = `Fecha: ${anterior.fecha}`;
            document.getElementById('cmp-ant-usr').innerText = `Usuario: ${anterior.usuario}`;
            document.getElementById('cmp-ant-motivo').innerText = `Motivo: ${anterior.comentario || '-'}`;

            document.getElementById('cmp-nue-fecha').innerText = `Fecha: ${actual.fecha}`;
            document.getElementById('cmp-nue-usr').innerText = `Usuario: ${actual.usuario}`;
            document.getElementById('cmp-nue-motivo').innerText = `Motivo: ${actual.comentario || '-'}`;

            const tbody = document.getElementById('tblComparadorBody');
            tbody.innerHTML = '';

            const minCambio = anterior.minVal !== actual.minVal;
            const maxCambio = anterior.maxVal !== actual.maxVal;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="fw-bold text-dark">${actual.parametro}</td>
                <td class="${minCambio ? 'bg-warning bg-opacity-25 text-dark fw-bold' : ''}">${anterior.minVal}</td>
                <td class="${minCambio ? 'bg-warning bg-opacity-50 text-dark fw-bold' : ''}">${actual.minVal} ${minCambio ? '⚠️' : ''}</td>
                <td class="${maxCambio ? 'bg-warning bg-opacity-25 text-dark fw-bold' : ''}">${anterior.maxVal}</td>
                <td class="${maxCambio ? 'bg-warning bg-opacity-50 text-dark fw-bold' : ''}">${actual.maxVal} ${maxCambio ? '⚠️' : ''}</td>
                <td>
                    ${(minCambio || maxCambio) 
                        ? '<span class="badge bg-warning text-dark">⚠️ RANGOS MODIFICADOS</span>' 
                        : '<span class="badge bg-light text-muted border">SIN CAMBIOS</span>'}
                </td>
            `;
            tbody.appendChild(tr);

            const modal = new bootstrap.Modal(document.getElementById('modalCompararRecetas'));
            modal.show();
        }

        function renderizarTabla(recetas) {
            if (!recetas || recetas.length === 0) { limpiarTabla(); return; }
            tblLimitesBody.innerHTML = '';
            recetas.forEach((r) => {
                const tr = document.createElement('tr');
                const param = r.Parametro || r.parametro || 'Límite Control';
                const minVal = r.MinVal ?? r.minVal ?? 0;
                const maxVal = r.MaxVal ?? r.maxVal ?? 0;
                const fechaRaw = r.FechaModificacion || r.fechaModificacion || '';
                const modPor = r.ModificadoPor || r.modificadoPor || 'SISTEMA_INICIAL';
                const estadoBool = r.Estado ?? r.estado ?? true;

                tr.innerHTML = `
                    <td class="fw-bold text-dark">${param}</td>
                    <td><span class="badge bg-secondary">Físico</span></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm fw-bold border-secondary" value="${minVal}"></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm fw-bold border-secondary" value="${maxVal}"></td>
                    <td><small class="text-muted font-monospace">${fechaRaw ? fechaRaw.toString().replace('T', ' ').slice(0, 19) : '-'}</small></td>
                    <td><span class="badge bg-light text-dark border">${modPor}</span></td>
                    <td><span class="badge ${estadoBool ? 'bg-success' : 'bg-danger'}">${estadoBool ? '🟢 ACTIVO' : '🔴 INACTIVO'}</span></td>
                `;
                tblLimitesBody.appendChild(tr);
            });
            btnGuardarCambios.disabled = false;
        }

        function limpiarTabla() {
            tblLimitesBody.innerHTML = `<tr><td colspan="7" class="text-center text-muted py-4">No hay parámetros seleccionados.</td></tr>`;
            btnGuardarCambios.disabled = true;
            if (lblUltimaMod) lblUltimaMod.innerText = 'N/A';
        }

        function mostrarNotificacion(mensaje, tipo = "success") {
            let container = document.getElementById('toastContainerWrapper');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toastContainerWrapper';
                container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                document.body.appendChild(container);
            }
            const toastId = 'toast_' + Date.now();
            const bgClass = tipo === 'success' ? 'bg-success text-white' : 'bg-danger text-white';
            const toastHtml = `<div id="${toastId}" class="toast align-items-center ${bgClass} border-0 shadow" role="alert"><div class="d-flex"><div class="toast-body">${mensaje}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
            container.insertAdjacentHTML('beforeend', toastHtml);
            new bootstrap.Toast(document.getElementById(toastId), { delay: 3500 }).show();
        }
    </script>
}
