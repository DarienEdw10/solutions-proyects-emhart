@model Enhartt.MVC.Models.ViewModels.RecetasViewModel

@{
    ViewData["Title"] = "Gestión de Recetas";
}

<!-- Fila de Selección Cascadas -->
<div class="row mb-4">
    <div class="col-md-4">
        <label class="form-label fw-bold">Seleccionar Celda</label>
        <select id="selectCelda" class="form-select">
            <option value="">-- Seleccione una Celda --</option>
            @if (Model?.Celdas != null)
            {
                foreach (var celda in Model.Celdas)
                {
                    <option value="@celda.Celda">@celda.Celda</option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label fw-bold">Seleccionar Salida / Pistola</label>
        <select id="selectSalida" class="form-select" disabled>
            <option value="">-- Seleccione una Celda Primero --</option>
        </select>
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <div class="p-2 bg-light border rounded w-100 d-flex justify-content-between align-items-center">
            <span class="text-muted small fw-bold">Última Modificación:</span>
            <span id="lblUltimaMod" class="badge bg-secondary">N/A</span>
        </div>
    </div>
</div>

<!-- Sección 1: Tabla de Límites de Calidad -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark">
            <i class="bi bi-sliders text-primary me-2"></i>Límites de Calidad (Parámetros Físicos)
        </h6>
        <button id="btnGuardarCambios" class="btn btn-success btn-sm" disabled>
            <i class="bi bi-floppy me-1"></i>Guardar Cambios
        </button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Parámetro</th>
                        <th>Unidad</th>
                        <th>Límite Mínimo (Min)</th>
                        <th>Límite Máximo (Max)</th>
                        <th>Fecha Último Cambio</th>
                        <th>Usuario</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody id="tblLimitesBody">
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No hay parámetros configurados para la combinación seleccionada.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Sección 2: Historial de Cambios y Auditoría -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-dark text-white py-3">
        <h6 class="mb-0 fw-bold">
            <i class="bi bi-clock-history me-2 text-warning"></i>Historial de Cambios y Auditoría de Recetas
        </h6>
    </div>
    <div class="card-body">
        <form id="formAuditoria" class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Fecha Inicio</label>
                <input type="date" id="fechaInicio" class="form-control form-control-sm">
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">Fecha Fin</label>
                <input type="date" id="fechaFin" class="form-control form-control-sm">
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="button" id="btnConsultarAuditoria" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-search me-1"></i>Consultar Auditoría
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm table-bordered text-center align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Celda / Salida</th>
                        <th>Parámetro</th>
                        <th>Límites Guardados (Mín | Máx)</th>
                        <th>Estatus Registro</th>
                        <th>Usuario</th>
                    </tr>
                </thead>
                <tbody id="tblAuditoriaBody">
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">
                            Selecciona un rango de fechas y presiona "Consultar Auditoría".
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Confirmación Bootstrap -->
<div class="modal fade" id="modalConfirmarGuardar" tabindex="-1" aria-labelledby="modalConfirmarLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fs-6 fw-bold" id="modalConfirmarLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Confirmar Modificación de Límites
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2 text-dark fs-6 fw-semibold">¿Estás seguro de que deseas guardar los nuevos límites de
                    calidad?</p>
                    <div class="alert alert-warning mb-0 py-2 small border-start border-4 border-warning">
                        <i class="bi bi-info-circle-fill me-1"></i> Esta acción actualizará los rangos de tolerancia
                        operativos en la base de datos y quedará registrada en la auditoría del sistema.
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Cancelar
                    </button>
                    <button type="button" id="btnConfirmarGuardarFinal" class="btn btn-sm btn-success fw-bold px-3">
                        <i class="bi bi-check-lg me-1"></i>Sí, Guardar Cambios
                    </button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            // Cargar todo el mapa de datos C# estructurado directamente en memoria del cliente
            const celdasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Celdas ?? new List<Enhartt.MVC.Models.ViewModels.CeldaViewModel>()));

            const selectCelda = document.getElementById('selectCelda');
            const selectSalida = document.getElementById('selectSalida');
            const tblLimitesBody = document.getElementById('tblLimitesBody');
            const btnGuardarCambios = document.getElementById('btnGuardarCambios');
            const lblUltimaMod = document.getElementById('lblUltimaMod');

            // Instancia del Modal Bootstrap
            const modalElement = document.getElementById('modalConfirmarGuardar');
            const modalConfirmar = new bootstrap.Modal(modalElement);
            const btnConfirmarGuardarFinal = document.getElementById('btnConfirmarGuardarFinal');

            const btnConsultarAuditoria = document.getElementById('btnConsultarAuditoria');
            const tblAuditoriaBody = document.getElementById('tblAuditoriaBody');
            const inputFechaInicio = document.getElementById('fechaInicio');
            const inputFechaFin = document.getElementById('fechaFin');

            // Evento al presionar Consultar Auditoría
            btnConsultarAuditoria.addEventListener('click', async function () {
                const fechaInicio = inputFechaInicio.value;
                const fechaFin = inputFechaFin.value;

                if (!fechaInicio || !fechaFin) {
                    mostrarNotificacion("Por favor selecciona un rango de fechas (Inicio y Fin).", "warning");
                    return;
                }

                // Opcional: Obtener la celda/salida seleccionada arriba para filtrar
                const idMaquina = selectSalida.value ? parseInt(selectSalida.value, 10) : '';
                const numSalida = selectSalida.options[selectSalida.selectedIndex]?.dataset.salida || '';
                const celdaNombre = selectCelda.value || 'General';

                btnConsultarAuditoria.disabled = true;
                btnConsultarAuditoria.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Buscando...';

                try {
                    const url = `/Recetas/ObtenerAuditoria?idMaquina=${idMaquina}&salida=${numSalida}&fechaInicio=${fechaInicio}&fechaFin=${fechaFin}`;
                    const response = await fetch(url);
                    const result = await response.json();

                    if (result.success) {
                        renderizarTablaAuditoria(result.data, celdaNombre);
                    } else {
                        mostrarNotificacion("Error: " + result.message, "danger");
                    }
                } catch (error) {
                    console.error("Error al consultar auditoría:", error);
                    mostrarNotificacion("Ocurrió un error al consultar el historial.", "danger");
                } finally {
                    btnConsultarAuditoria.disabled = false;
                    btnConsultarAuditoria.innerHTML = '<i class="bi bi-search me-1"></i>Consultar Auditoría';
                }
            });

            function renderizarTablaAuditoria(datos, celdaNombre) {
                if (!datos || datos.length === 0) {
                    tblAuditoriaBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">
                            No se encontraron registros de auditoría para el rango de fechas seleccionado.
                        </td>
                    </tr>`;
                    return;
                }

                tblAuditoriaBody.innerHTML = '';

                datos.forEach(item => {
                    const tr = document.createElement('tr');
                    const esActivo = item.estado === "ACTIVO";

                    tr.innerHTML = `
                    <td class="small font-monospace">${item.fecha}</td>
                    <td><span class="badge bg-secondary">${celdaNombre} / Salida ${item.salida}</span></td>
                    <td class="fw-bold">${item.parametro}</td>
                    <td><code class="text-dark fw-bold">${item.minVal}</code> | <code class="text-dark fw-bold">${item.maxVal}</code></td>
                    <td><span class="badge ${esActivo ? 'bg-success' : 'bg-danger'}">${esActivo ? '🟢 ACTIVO' : '🔴 INACTIVO'}</span></td>
                    <td><span class="badge bg-light text-dark border">${item.usuario}</span></td>
                `;
                    tblAuditoriaBody.appendChild(tr);
                });
            }

            // 1. Manejar cambio en la Celda seleccionada
            selectCelda.addEventListener('change', function () {
                const celdaNombre = this.value;

                selectSalida.innerHTML = '<option value="">-- Seleccione una Salida / Pistola --</option>';
                selectSalida.disabled = true;
                limpiarTabla();

                if (!celdaNombre) return;

                const celdaEncontrada = celdasData.find(c => (c.Celda || c.celda) === celdaNombre);

                if (celdaEncontrada) {
                    const maquinas = celdaEncontrada.Maquinas || celdaEncontrada.maquinas || [];
                    let haySalidas = false;

                    maquinas.forEach(maquina => {
                        const recetas = maquina.Recetas || maquina.recetas || [];
                        const salidasUnicas = [...new Set(recetas.map(r => String(r.Salida || r.salida)))];

                        salidasUnicas.forEach(numSalida => {
                            if (numSalida && numSalida !== "undefined") {
                                const option = document.createElement('option');
                                option.value = maquina.Id || maquina.id;
                                option.dataset.salida = numSalida;
                                option.textContent = `Salida: ${numSalida} (Máquina: ${maquina.IdMaquina || maquina.idMaquina})`;
                                selectSalida.appendChild(option);
                                haySalidas = true;
                            }
                        });
                    });

                    if (haySalidas) {
                        selectSalida.disabled = false;
                    }
                }
            });

            // 2. Manejar cambio en la Salida seleccionada -> Pinta las filas de parámetros
            selectSalida.addEventListener('change', function () {
                const idMaquina = parseInt(this.value, 10);
                const numSalida = this.options[this.selectedIndex]?.dataset.salida;
                const celdaNombre = selectCelda.value;

                if (!idMaquina || !numSalida || !celdaNombre) {
                    limpiarTabla();
                    return;
                }

                const celdaObj = celdasData.find(c => (c.Celda || c.celda) === celdaNombre);
                const maquinas = celdaObj?.Maquinas || celdaObj?.maquinas || [];
                const maquinaObj = maquinas.find(m => (m.Id || m.id) === idMaquina);
                const recetas = maquinaObj?.Recetas || maquinaObj?.recetas || [];

                const parametrosEncontrados = recetas.filter(r =>
                    String(r.Salida || r.salida) === String(numSalida) &&
                    (r.Estado ?? r.estado ?? true)
                );

                renderizarTabla(parametrosEncontrados);
            });

            // 3. Al dar clic en "Guardar Cambios" -> Abrir Modal de Confirmación
            btnGuardarCambios.addEventListener('click', function () {
                const idMaquina = parseInt(selectSalida.value, 10);
                const numSalida = selectSalida.options[selectSalida.selectedIndex]?.dataset.salida;

                if (!idMaquina || !numSalida) {
                    mostrarNotificacion("Por favor selecciona una celda y salida válidas.", "warning");
                    return;
                }

                modalConfirmar.show();
            });

            // 4. Al confirmar dentro del Modal -> Ejecutar la petición POST al Servidor
            btnConfirmarGuardarFinal.addEventListener('click', async function () {
                const idMaquina = parseInt(selectSalida.value, 10);
                const numSalida = selectSalida.options[selectSalida.selectedIndex]?.dataset.salida;

                const filas = tblLimitesBody.querySelectorAll('tr');
                const listaParametros = [];

                filas.forEach(row => {
                    const celdaParam = row.cells[0]?.innerText.trim();
                    const inputs = row.querySelectorAll('input[type="number"]');

                    if (celdaParam && inputs.length === 2) {
                        const minVal = parseFloat(inputs[0].value);
                        const maxVal = parseFloat(inputs[1].value);

                        listaParametros.push({
                            Parametro: celdaParam,
                            MinVal: isNaN(minVal) ? 0 : minVal,
                            MaxVal: isNaN(maxVal) ? 0 : maxVal
                        });
                    }
                });

                if (listaParametros.length === 0) {
                    modalConfirmar.hide();
                    mostrarNotificacion("No hay parámetros disponibles para guardar.", "warning");
                    return;
                }

                modalConfirmar.hide();
                btnGuardarCambios.disabled = true;
                btnGuardarCambios.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Guardando...';

                try {
                    const response = await fetch('/Recetas/Guardar', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            IdMaquina: idMaquina,
                            Salida: numSalida,
                            Parametros: listaParametros
                        })
                    });

                    const result = await response.json();

                    if (result.success) {
                        mostrarNotificacion(result.message, "success");
                        if (lblUltimaMod) {
                            lblUltimaMod.innerText = new Date().toLocaleTimeString();
                        }
                    } else {
                        mostrarNotificacion("Error al guardar: " + result.message, "danger");
                    }
                } catch (error) {
                    console.error("Error en la solicitud:", error);
                    mostrarNotificacion("Ocurrió un problema de red al intentar guardar los límites.", "danger");
                } finally {
                    btnGuardarCambios.disabled = false;
                    btnGuardarCambios.innerHTML = '<i class="bi bi-floppy me-1"></i>Guardar Cambios';
                }
            });

            function renderizarTabla(recetas) {
                if (!recetas || recetas.length === 0) {
                    limpiarTabla();
                    return;
                }

                tblLimitesBody.innerHTML = '';

                const fechas = recetas
                    .map(r => r.FechaModificacion || r.fechaModificacion)
                    .filter(f => f)
                    .sort()
                    .reverse();

                recetas.forEach((r) => {
                    const tr = document.createElement('tr');

                    const param = r.Parametro || r.parametro || 'Límite Control';
                    const minVal = r.MinVal ?? r.minVal ?? 0;
                    const maxVal = r.MaxVal ?? r.maxVal ?? 0;
                    const fechaRaw = r.FechaModificacion || r.fechaModificacion || '';
                    const modPor = r.ModificadoPor || r.modificadoPor || 'SISTEMA_INICIAL';
                    const estadoBool = r.Estado ?? r.estado ?? true;

                    const fechaTxt = fechaRaw ? fechaRaw.toString().replace('T', ' ').slice(0, 19) : 'Sin registro';

                    tr.innerHTML = `
                            <td class="fw-bold text-dark">${param}</td>
                            <td><span class="badge bg-secondary">Físico</span></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm fw-bold border-secondary" value="${minVal}"></td>
                            <td><input type="number" step="0.01" class="form-control form-control-sm fw-bold border-secondary" value="${maxVal}"></td>
                            <td><small class="text-muted font-monospace"><i class="bi bi-clock-history me-1"></i>${fechaTxt}</small></td>
                            <td><span class="badge bg-light text-dark border">${modPor}</span></td>
                            <td><span class="badge ${estadoBool ? 'bg-success' : 'bg-danger'}">${estadoBool ? '🟢 ACTIVO' : '🔴 INACTIVO'}</span></td>
                        `;
                    tblLimitesBody.appendChild(tr);
                });

                if (btnGuardarCambios) btnGuardarCambios.disabled = false;
                if (lblUltimaMod) {
                    lblUltimaMod.innerText = fechas[0] ? fechas[0].toString().replace('T', ' ').slice(0, 19) : new Date().toLocaleTimeString();
                }
            }

            function limpiarTabla() {
                if (tblLimitesBody) {
                    tblLimitesBody.innerHTML = `
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No hay parámetros configurados para la combinación seleccionada.
                                </td>
                            </tr>`;
                }
                if (btnGuardarCambios) btnGuardarCambios.disabled = true;
                if (lblUltimaMod) lblUltimaMod.innerText = 'N/A';
            }

            // Sistema dinámico de Toasts de Bootstrap
            function mostrarNotificacion(mensaje, tipo = "success") {
                let container = document.getElementById('toastContainerWrapper');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'toastContainerWrapper';
                    container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                    container.style.zIndex = '1090';
                    document.body.appendChild(container);
                }

                const toastId = 'toast_' + Date.now();
                const bgClass = tipo === 'success' ? 'bg-success text-white' : (tipo === 'warning' ? 'bg-warning text-dark' : 'bg-danger text-white');
                const iconClass = tipo === 'success' ? 'bi-check-circle-fill' : (tipo === 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-exclamation-octagon-fill');

                const toastHtml = `
                        <div id="${toastId}" class="toast align-items-center ${bgClass} border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex">
                                <div class="toast-body d-flex align-items-center gap-2">
                                    <i class="bi ${iconClass} fs-5"></i>
                                    <span class="fw-semibold">${mensaje}</span>
                                </div>
                                <button type="button" class="btn-close ${tipo === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                        </div>
                    `;

                container.insertAdjacentHTML('beforeend', toastHtml);
                const toastEl = document.getElementById(toastId);
                const bsToast = new bootstrap.Toast(toastEl, { delay: 4000 });
                bsToast.show();
            }
        </script>
    }