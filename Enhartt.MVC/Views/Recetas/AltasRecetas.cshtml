@model Enhartt.MVC.Models.ViewModels.RecetasViewModel

@{
    ViewData["Title"] = "Altas de Celdas y Salidas";
}

<!-- Encabezado Principal de la Vista -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary d-inline-flex">
                <i class="bi bi-plus-square-fill fs-5"></i>
            </span>
            <span>Altas de Celdas y Salidas</span>
        </h4>
        <small class="text-muted">Registro de nueva infraestructura Tucker e inicialización de pistolas en base de
            datos.</small>
        </div>
    </div>

    <div class="row g-3">
        <!-- Formulario 1: Alta de Nueva Celda (Tabla Maquinas) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 overflow-hidden"
                 style="background: #ffffff; border: 1px solid #e2e8f0; border-top: 3px solid #10b981 !important;">
                <!-- Encabezado Dark Slate con Acento Verde Esmeralda -->
                <div class="card-header border-0 px-3 py-2 d-flex justify-content-between align-items-center"
                     style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-1 px-2 rounded-2 d-flex align-items-center justify-content-center"
                             style="background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4);">
                            <i class="bi bi-cpu-fill text-success fs-6"></i>
                        </div>
                        <div>
                            <span class="fw-bold small text-white d-block lh-1" style="letter-spacing: 0.3px;">1. Registrar
                                Nueva Celda / Estación</span>
                                <span class="d-block mt-1" style="font-size: 0.73rem; color: #94a3b8;">Infraestructura base en
                                    tabla maquinas</span>
                                </div>
                            </div>
                            <span
                                class="badge rounded-pill bg-success bg-opacity-25 text-success border border-success-subtle px-2 py-1"
                                style="font-size: 0.68rem;">
                                NUEVA CELDA
                            </span>
                        </div>

                        <!-- Cuerpo del Formulario -->
                        <div class="card-body p-3 bg-light bg-opacity-25">
                            <!-- Field 1: Planta -->
                            <div class="bg-white p-2 rounded-2 border border-light-subtle shadow-sm mb-2">
                                <label class="form-label text-secondary fw-semibold mb-1 d-flex align-items-center"
                                       style="font-size: 0.75rem;">
                                    <i class="bi bi-geo-alt-fill text-primary me-1"></i>Planta / Ubicación
                                </label>
                                <select id="selectPlanta"
                                        class="form-select form-select-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0"
                                        style="font-size: 0.85rem;">
                                    <option value="AUTOTEK CUAUTITLÁN">AUTOTEK CUAUTITLÁN</option>
                                    <option value="NUEVO_VALOR" class="text-primary">+ REGISTRAR OTRA PLANTA...</option>
                                </select>
                                <input type="text" id="txtNuevoPlanta"
                                       class="form-control form-control-sm d-none fw-bold mt-2 border-secondary-subtle"
                                       style="text-transform: uppercase; font-size: 0.85rem;"
                                       placeholder="ESCRIBE EL NOMBRE DE LA NUEVA PLANTA">
                            </div>

                            <!-- Field 2: Línea -->
                            <div class="bg-white p-2 rounded-2 border border-light-subtle shadow-sm mb-2">
                                <label class="form-label text-secondary fw-semibold mb-1 d-flex align-items-center"
                                       style="font-size: 0.75rem;">
                                    <i class="bi bi-diagram-2-fill text-info me-1"></i>Línea de Producción
                                </label>
                                <select id="selectLinea"
                                        class="form-select form-select-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0"
                                        style="font-size: 0.85rem;">
                                    <option value="LÍNEA 1">LÍNEA 1</option>
                                    <option value="LÍNEA 2">LÍNEA 2</option>
                                    <option value="NUEVO_VALOR" class="text-primary">+ REGISTRAR OTRA LÍNEA...</option>
                                </select>
                                <input type="text" id="txtNuevoLinea"
                                       class="form-control form-control-sm d-none fw-bold mt-2 border-secondary-subtle"
                                       style="text-transform: uppercase; font-size: 0.85rem;"
                                       placeholder="ESCRIBE EL NOMBRE DE LA NUEVA LÍNEA">
                            </div>

                            <!-- Field 3: Nombre de Celda / Proyecto -->
                            <div class="bg-white p-2 rounded-2 border border-light-subtle shadow-sm mb-2">
                                <label class="form-label text-secondary fw-semibold mb-1 d-flex align-items-center"
                                       style="font-size: 0.75rem;">
                                    <i class="bi bi-bounding-box text-warning me-1"></i>Nombre de Celda / Proyecto
                                </label>
                                <select id="selectCeldaNombre"
                                        class="form-select form-select-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0"
                                        style="font-size: 0.85rem;">
                                    <option value="">-- Seleccione Celda --</option>
                                    @if (Model?.Celdas != null)
                                    {
                                        foreach (var c in Model.Celdas)
                                        {
                                            <option value="@c.Celda">@c.Celda</option>
                                        }
                                    }
                                    <option value="NUEVO_VALOR" class="fw-bold text-primary">+ REGISTRAR NUEVA CELDA / PROYECTO...
                                    </option>
                                </select>
                                <input type="text" id="txtNuevoCeldaNombre"
                                       class="form-control form-control-sm d-none fw-bold mt-2 border-secondary-subtle"
                                       style="text-transform: uppercase; font-size: 0.85rem;"
                                       placeholder="ESCRIBE EL NOMBRE DE LA NUEVA CELDA">
                            </div>

                            <!-- Field 4: Estación / ID Celda -->
                            <div class="bg-white p-2 rounded-2 border border-light-subtle shadow-sm mb-2">
                                <label class="form-label text-secondary fw-semibold mb-1 d-flex align-items-center"
                                       style="font-size: 0.75rem;">
                                    <i class="bi bi-upc-scan text-danger me-1"></i>Identificador de Máquina (ID Celda / Estación)
                                </label>
                                <select id="selectIdMaquina"
                                        class="form-select form-select-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0"
                                        style="font-size: 0.85rem;">
                                    <option value="">-- Seleccione ID Máquina --</option>
                                    @if (Model?.Celdas != null)
                                    {
                                        var idsMaquinas = Model.Celdas.SelectMany(c => c.Maquinas).Select(m => m.IdMaquina).Where(id =>
                                        !string.IsNullOrEmpty(id)).Distinct();
                                        foreach (var id in idsMaquinas)
                                        {
                                            <option value="@id">@id</option>
                                        }
                                    }
                                    <option value="NUEVO_VALOR" class="fw-bold text-primary">+ REGISTRAR NUEVO ID MÁQUINA...
                                    </option>
                                </select>
                                <input type="text" id="txtNuevoIdMaquina"
                                       class="form-control form-control-sm d-none fw-bold mt-2 border-secondary-subtle"
                                       style="text-transform: uppercase; font-size: 0.85rem;"
                                       placeholder="ESCRIBE EL NUEVO ID DE MÁQUINA (EJ. CELDA-04)">
                            </div>

                            <!-- Field 5: Salida Inicial -->
                            <div class="bg-white p-2 rounded-2 border border-light-subtle shadow-sm mb-3">
                                <label class="form-label text-secondary fw-semibold mb-1 d-flex align-items-center"
                                       style="font-size: 0.75rem;">
                                    <i class="bi bi-crosshair text-primary me-1"></i>Número de Salida / Pistola Inicial
                                </label>
                                <input type="number" id="txtSalidaInicialCelda"
                                       class="form-control form-control-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0"
                                       value="1" min="1" max="99" placeholder="Ej. 1, 2, 4..." style="font-size: 0.85rem;">
                            </div>

                            <!-- Alerta Informativa -->
                            <div class="alert alert-info py-2 px-3 small mb-0 rounded-2 d-flex align-items-center gap-2 border-0"
                                 style="background: rgba(14, 165, 233, 0.12); color: #0369a1; font-size: 0.76rem;">
                                <i class="bi bi-info-circle-fill fs-6 flex-shrink-0"></i>
                                <span>Se creará el registro en <code>maquinas</code> y se inicializarán los 6 parámetros en la
                                    <b>Salida</b> indicada en <code>recetas</code>.</span>
                                </div>
                            </div>

                            <!-- Footer con Botón -->
                            <div class="card-footer bg-white border-top px-3 py-2 text-end" style="border-color: #e2e8f0 !important;">
                                <button type="button" id="btnGuardarNuevaCelda"
                                        class="btn btn-sm btn-success fw-bold px-3 py-2 shadow-sm d-inline-flex align-items-center gap-1 border-0"
                                        style="background: linear-gradient(135deg, #10b981, #059669); font-size: 0.82rem;">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>Dar de Alta Celda</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Formulario 2: Alta de Nueva Salida (Tabla Recetas) -->
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm rounded-3 h-100 overflow-hidden"
                             style="background: #ffffff; border: 1px solid #e2e8f0; border-top: 3px solid #0284c7 !important;">
                            <!-- Encabezado Dark Slate con Acento Cyan / Azul -->
                            <div class="card-header border-0 px-3 py-2 d-flex justify-content-between align-items-center"
                                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-1 px-2 rounded-2 d-flex align-items-center justify-content-center"
                                         style="background: rgba(14, 165, 233, 0.2); border: 1px solid rgba(14, 165, 233, 0.4);">
                                        <i class="bi bi-diagram-3-fill text-info fs-6"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bold small text-white d-block lh-1" style="letter-spacing: 0.3px;">2. Agregar
                                            Salida / Pistola a Celda Existente</span>
                                            <span class="d-block mt-1" style="font-size: 0.73rem; color: #94a3b8;">Ampliación de parámetros
                                                en tabla recetas</span>
                                            </div>
                                        </div>
                                        <span class="badge rounded-pill bg-primary bg-opacity-25 text-info border border-info-subtle px-2 py-1"
                                              style="font-size: 0.68rem;">
                                            NUEVA SALIDA
                                        </span>
                                    </div>

                                    <!-- Cuerpo del Formulario -->
                                    <div class="card-body p-3 bg-light bg-opacity-25 d-flex flex-column justify-content-between">
                                        <div>
                                            <!-- Selección de Celda -->
                                            <div class="bg-white p-2 rounded-2 border border-light-subtle shadow-sm mb-2">
                                                <label class="form-label text-secondary fw-semibold mb-1 d-flex align-items-center"
                                                       style="font-size: 0.75rem;">
                                                    <i class="bi bi-cpu-fill text-primary me-1"></i>Seleccionar Celda Existente
                                                </label>
                                                <select id="selectCeldaAlta"
                                                        class="form-select form-select-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0"
                                                        style="font-size: 0.85rem;">
                                                    <option value="">-- Seleccione una Celda --</option>
                                                    @if (Model?.Celdas != null)
                                                    {
                                                        foreach (var celda in Model.Celdas)
                                                        {
                                                            <option value="@celda.Celda">@celda.Celda</option>
                                                        }
                                                    }
                                                </select>
                                            </div>

                                            <!-- Número de Salida -->
                                            <div class="bg-white p-2 rounded-2 border border-light-subtle shadow-sm mb-3">
                                                <label class="form-label text-secondary fw-semibold mb-1 d-flex align-items-center"
                                                       style="font-size: 0.75rem;">
                                                    <i class="bi bi-123 text-info me-1"></i>Número de Salida / Pistola a Agregar
                                                </label>
                                                <input type="number" id="txtAltaNumeroSalida"
                                                       class="form-control form-control-sm border-0 bg-transparent fw-bold text-dark shadow-none p-0"
                                                       placeholder="Ej. 2" min="1" max="99" style="font-size: 0.85rem;">
                                            </div>

                                            <!-- Alerta de Herencia de Parámetros -->
                                            <div class="alert alert-warning py-2 px-3 small mb-0 rounded-2 d-flex align-items-center gap-2 border-0"
                                                 style="background: rgba(245, 158, 11, 0.12); color: #b45309; font-size: 0.76rem;">
                                                <i class="bi bi-lightning-charge-fill fs-6 flex-shrink-0"></i>
                                                <span>Se generarán los 6 parámetros físicos en <code>recetas</code> (VolArc, VolPri, Corriente,
                                                    Tiempo, Penetración y Energía) heredando las tolerancias base de la celda.</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Footer con Botón -->
                                        <div class="card-footer bg-white border-top px-3 py-2 text-end" style="border-color: #e2e8f0 !important;">
                                            <button type="button" id="btnGuardarNuevaSalida"
                                                    class="btn btn-sm btn-primary fw-bold px-3 py-2 shadow-sm d-inline-flex align-items-center gap-1 border-0"
                                                    style="background: linear-gradient(135deg, #0284c7, #0369a1); font-size: 0.82rem;">
                                                <i class="bi bi-plus-circle-fill"></i>
                                                <span>Dar de Alta Salida</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @section Scripts {
                                <script>

                                    const celdasData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.Celdas ?? new List<Enhartt.MVC.Models.ViewModels.CeldaViewModel>()));

                                    // Referencias de Selects e Inputs de Texto Alternativos
                                    const selectPlanta = document.getElementById('selectPlanta');
                                    const txtNuevoPlanta = document.getElementById('txtNuevoPlanta');

                                    const selectLinea = document.getElementById('selectLinea');
                                    const txtNuevoLinea = document.getElementById('txtNuevoLinea');

                                    const selectCeldaNombre = document.getElementById('selectCeldaNombre');
                                    const txtNuevoCeldaNombre = document.getElementById('txtNuevoCeldaNombre');

                                    const selectIdMaquina = document.getElementById('selectIdMaquina');
                                    const txtNuevoIdMaquina = document.getElementById('txtNuevoIdMaquina');

                                    const btnGuardarNuevaCelda = document.getElementById('btnGuardarNuevaCelda');

                                    const selectCeldaAlta = document.getElementById('selectCeldaAlta');
                                    const txtAltaNumeroSalida = document.getElementById('txtAltaNumeroSalida');
                                    const btnGuardarNuevaSalida = document.getElementById('btnGuardarNuevaSalida');

                                    // 1. Mostrar/Ocultar campos de texto libres según la opción del Select
                                    function configurarToggleSelect(selectEl, inputEl) {
                                        if (!selectEl || !inputEl) return;

                                        selectEl.addEventListener('change', function () {
                                            if (this.value === 'NUEVO_VALOR') {
                                                inputEl.classList.remove('d-none');
                                                inputEl.focus();
                                            } else {
                                                inputEl.classList.add('d-none');
                                                inputEl.value = '';
                                            }
                                        });

                                        // Formato Mayúsculas y Sanitización de espacios en el input nuevo
                                        inputEl.addEventListener('input', function () {
                                            let pos = this.selectionStart;
                                            let limpio = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ').toUpperCase();
                                            if (this.value !== limpio) {
                                                this.value = limpio;
                                                this.setSelectionRange(pos, pos);
                                            }
                                        });

                                        inputEl.addEventListener('blur', function () {
                                            this.value = this.value.trim();
                                        });
                                    }

                                    configurarToggleSelect(selectPlanta, txtNuevoPlanta);
                                    configurarToggleSelect(selectLinea, txtNuevoLinea);
                                    configurarToggleSelect(selectCeldaNombre, txtNuevoCeldaNombre);
                                    configurarToggleSelect(selectIdMaquina, txtNuevoIdMaquina);

                                    // 2. Guardar Nueva Celda
                                    btnGuardarNuevaCelda.addEventListener('click', async function () {
                                        const planta = selectPlanta.value === 'NUEVO_VALOR' ? txtNuevoPlanta.value.trim().toUpperCase() : selectPlanta.value.trim().toUpperCase();
                                        const linea = selectLinea.value === 'NUEVO_VALOR' ? txtNuevoLinea.value.trim().toUpperCase() : selectLinea.value.trim().toUpperCase();
                                        const nombreCelda = selectCeldaNombre.value === 'NUEVO_VALOR' ? txtNuevoCeldaNombre.value.trim().toUpperCase() : selectCeldaNombre.value.trim().toUpperCase();
                                        const idMaquina = selectIdMaquina.value === 'NUEVO_VALOR' ? txtNuevoIdMaquina.value.trim().toUpperCase() : selectIdMaquina.value.trim().toUpperCase();

                                        const numSalidaInicial = parseInt(document.getElementById('txtSalidaInicialCelda').value, 10) || 1;

                                        if (!nombreCelda || !idMaquina) {
                                            mostrarToast("Por favor selecciona o escribe el Nombre de Celda e ID de Máquina.", "warning");
                                            return;
                                        }

                                        btnGuardarNuevaCelda.disabled = true;
                                        btnGuardarNuevaCelda.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Guardando...';

                                        try {
                                            const response = await fetch('/Recetas/AgregarCelda', {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/json' },
                                                body: JSON.stringify({
                                                    Planta: planta || "AUTOTEK CUAUTITLÁN",
                                                    Linea: linea || "LÍNEA 1",
                                                    NombreCelda: nombreCelda,
                                                    IdMaquina: idMaquina,
                                                    SalidaInicial: numSalidaInicial
                                                })
                                            });

                                            const result = await response.json();
                                            if (result.success) {
                                                mostrarToast(result.message, "success");
                                                setTimeout(() => window.location.reload(), 1200);
                                            } else {
                                                mostrarToast("Error: " + result.message, "danger");
                                            }
                                        } catch (e) {
                                            mostrarToast("Error al procesar la alta de la celda.", "danger");
                                        } finally {
                                            btnGuardarNuevaCelda.disabled = false;
                                            btnGuardarNuevaCelda.innerHTML = '<i class="bi bi-check-circle me-1"></i>Dar de Alta Celda';
                                        }
                                    });

                                    // 3. Guardar Salida
                                    btnGuardarNuevaSalida.addEventListener('click', async function () {
                                        const celdaNombre = selectCeldaAlta.value;
                                        const numSalida = parseInt(txtAltaNumeroSalida.value, 10);

                                        if (!celdaNombre || !numSalida || numSalida <= 0) {
                                            mostrarToast("Selecciona una celda e ingresa un número de salida válido.", "warning");
                                            return;
                                        }

                                        const celdaObj = celdasData.find(c => (c.Celda || c.celda) === celdaNombre);
                                        const maquinas = celdaObj?.Maquinas || celdaObj?.maquinas || [];
                                        const maquina = maquinas.length > 0 ? maquinas[0] : null;
                                        const idMaquina = maquina?.Id || maquina?.id;

                                        if (!idMaquina) {
                                            mostrarToast("No se encontró el ID de la máquina en base de datos.", "danger");
                                            return;
                                        }

                                        btnGuardarNuevaSalida.disabled = true;
                                        btnGuardarNuevaSalida.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Creando...';

                                        try {
                                            const response = await fetch('/Recetas/AgregarSalida', {
                                                method: 'POST',
                                                headers: { 'Content-Type': 'application/json' },
                                                body: JSON.stringify({ IdMaquina: idMaquina, NumeroSalida: numSalida })
                                            });

                                            const result = await response.json();
                                            if (result.success) {
                                                mostrarToast(result.message, "success");
                                                txtAltaNumeroSalida.value = '';
                                                // Recargar tras 1.2s para actualizar celdasData en memoria
                                                setTimeout(() => window.location.reload(), 1200);
                                            } else {
                                                mostrarToast("Error: " + result.message, "danger");
                                            }
                                        } catch (e) {
                                            mostrarToast("Error de conexión al dar de alta la salida.", "danger");
                                        } finally {
                                            btnGuardarNuevaSalida.disabled = false;
                                            btnGuardarNuevaSalida.innerHTML = '<i class="bi bi-plus-circle me-1"></i>Dar de Alta Salida';
                                        }
                                    });

                                    function mostrarToast(mensaje, tipo = "success") {
                                        let container = document.getElementById('toastContainerWrapper');
                                        if (!container) {
                                            container = document.createElement('div');
                                            container.id = 'toastContainerWrapper';
                                            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                                            document.body.appendChild(container);
                                        }
                                        const toastId = 'toast_' + Date.now();
                                        const bgClass = tipo === 'success' ? 'bg-success text-white' : (tipo === 'warning' ? 'bg-warning text-dark' : 'bg-danger text-white');
                                        const toastHtml = `<div id="${toastId}" class="toast align-items-center ${bgClass} border-0 shadow" role="alert"><div class="d-flex"><div class="toast-body">${mensaje}</div><button type="button" class="btn-close ${tipo === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
                                        container.insertAdjacentHTML('beforeend', toastHtml);
                                        new bootstrap.Toast(document.getElementById(toastId), { delay: 3500 }).show();
                                    }
                                </script>
                            }
