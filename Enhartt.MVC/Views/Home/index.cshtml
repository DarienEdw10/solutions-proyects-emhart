@{
    ViewData["Title"] = "Monitoreo Celdas Tucker";
}

<!-- Estado de Salud de las Celdas -->
<div class="row g-2 g-md-3 mb-3 mb-md-4">
    <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm p-3 bg-white border-start border-success border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase d-block">Celda Operativa</span>
                    <h5 class="fw-bold mb-0 text-dark">CELDA-01</h5>
                </div>
                <div class="text-end">
                    <span class="badge bg-success mb-1" id="badge-estatus-celda-1">🟢 OPERANDO</span>
                    <div class="small text-muted font-monospace" id="lbl-tiempo-celda-1">Último disparo: -</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm p-3 bg-white border-start border-warning border-4">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold text-uppercase d-block">Celda Operativa</span>
                    <h5 class="fw-bold mb-0 text-dark">CELDA-03</h5>
                </div>
                <div class="text-end">
                    <span class="badge bg-warning text-dark mb-1" id="badge-estatus-celda-3">⚠️ ATENCIÓN (1 NOK)</span>
                    <div class="small text-muted font-monospace" id="lbl-tiempo-celda-3">Último disparo: -</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPIs de Producción -->
<div class="row g-2 g-md-3 mb-3 mb-md-4">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase">Total Disparos</div>
                <div class="h3 mb-0 fw-bold text-dark" id="lbl-total-disparos">0</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase">Calidad OK</div>
                <div class="h3 mb-0 fw-bold text-success" id="lbl-calidad-ok">0</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-danger border-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase">Desviaciones (NOK)</div>
                <div class="h3 mb-0 fw-bold text-danger" id="lbl-desviaciones-nok">0</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-info border-4 h-100">
            <div class="card-body p-3">
                <div class="text-muted small fw-bold text-uppercase">Efectividad (FTT)</div>
                <div class="h3 mb-0 fw-bold text-info" id="lbl-efectividad-ftt">0%</div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros y Buscador Rápido -->
<div class="row g-3 align-items-end">
    <div class="col-md-2">
        <label class="form-label fw-bold small">Celda</label>
        <select id="filtro-celda" class="form-select">
            <option value="">-- Cargando... --</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold small">Estatus Calidad</label>
        <select id="filtro-estatus" class="form-select">
            <option value="">-- Todos --</option>
            <option value="Solo OK">🟢 Solo OK</option>
            <option value="Solo NOK">🔴 Solo NOK</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold small">Fecha Inicio</label>
        <input type="date" id="filtro-fecha-inicio" class="form-control">
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold small">Fecha Fin</label>
        <input type="date" id="filtro-fecha-fin" class="form-control">
    </div>
    <div class="col-md-2">
        <label class="form-label fw-bold small">Búsqueda Rápida</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="buscador-global" class="form-control" placeholder="Ej. #7440...">
        </div>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary w-100 fw-bold" onclick="aplicarFiltros()">
            <i class="bi bi-funnel-fill me-1"></i> Filtrar Datos
        </button>
    </div>
</div>

<!-- Gráfica de Tendencia -->
<div class="card border-0 shadow-sm my-3 my-md-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0 fw-bold">
            <i class="bi bi-graph-up text-primary me-2"></i>Tendencia de Corriente (A) y Límites de Tolerancia
        </h6>
        <span class="badge bg-light text-dark border">Monitoreo SPC</span>
    </div>
    <div class="card-body">
        <div style="position: relative; height: 240px; width: 100%;">
            <canvas id="graficaControl"></canvas>
        </div>
    </div>
</div>

<!-- Tabla Principal -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="card-title mb-0 fw-bold">
            <i class="bi bi-list-task me-2 text-primary"></i>Registros Recientes <small class="text-muted fw-normal">(Haz clic en una fila para ver el detalle técnico)</small>
        </h6>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success btn-sm fw-bold" onclick="exportarExcel()">
                <i class="bi bi-file-earmark-excel-fill me-1"></i>Excel
            </button>
            <button class="btn btn-outline-danger btn-sm fw-bold" onclick="exportarPDF()">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>PDF
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-nowrap" id="tabla-monitoreo">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha / Hora</th>
                        <th>Celda</th>
                        <th>Salida</th>
                        <th>Turno</th>
                        <th>N° Soldadura</th>
                        <th>Corriente</th>
                        <th>Energía</th>
                        <th>Tiempo</th>
                        <th>Penetración</th>
                        <th>Estatus</th>
                        <th>Detalle Desviación</th>
                    </tr>
                </thead>
                <tbody id="tabla-body">
                    <!-- Inyección JS -->
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white py-2 d-flex justify-content-between align-items-center">
        <span class="small text-muted" id="lbl-paginacion-info">Mostrando 0-0 de 0 registros</span>
        <nav>
            <ul class="pagination pagination-sm mb-0" id="ul-paginacion">
                <!-- Páginas JS -->
            </ul>
        </nav>
    </div>
</div>

<!-- Modal de Ficha Técnica Detallada -->
<div class="modal fade" id="modalDetalleSoldadura" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-cpu text-warning me-2"></i>Ficha Técnica de Soldadura <span id="modal-num-sol"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="p-2 border rounded bg-light">
                            <small class="text-muted d-block">Serial Trazabilidad</small>
                            <strong class="font-monospace text-primary" id="modal-serial">-</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-2 border rounded bg-light">
                            <small class="text-muted d-block">Timestamp de Celda</small>
                            <strong id="modal-fecha">-</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-2 border rounded bg-light">
                            <small class="text-muted d-block">Estatus de Calidad</small>
                            <span id="modal-estatus-badge">-</span>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold border-bottom pb-2 mt-4 text-secondary">
                    <i class="bi bi-lightning-charge me-1"></i>Parámetros Eléctricos y Mecánicos
                </h6>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Voltaje Arco Piloto</small>
                        <strong id="modal-volarc">-</strong> V
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Voltaje Principal</small>
                        <strong id="modal-volpri">-</strong> V
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Corriente de Soldadura</small>
                        <strong id="modal-corriente">-</strong> A
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Energía Disipada</small>
                        <strong id="modal-energia">-</strong> J
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Tiempo de Arco</small>
                        <strong id="modal-tiempo">-</strong> ms
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Penetración Perno</small>
                        <strong id="modal-penetracion">-</strong> mm
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Elevación Pistola</small>
                        <strong id="modal-elevacion">-</strong> mm
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Longitud Perno</small>
                        <strong id="modal-lonper">-</strong> mm
                    </div>
                </div>

                <h6 class="fw-bold border-bottom pb-2 mt-4 text-secondary">
                    <i class="bi bi-shield-exclamation me-1"></i>Diagnóstico de Controlador Tucker
                </h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <small class="text-muted d-block">Código de Error</small>
                        <span class="badge bg-secondary" id="modal-err">Err: 0</span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Alarma del Sistema</small>
                        <span class="badge bg-secondary" id="modal-alarma">Alarma: 0</span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Modo de Operación</small>
                        <span class="badge bg-info text-dark" id="modal-modo">Modo: Auto (1)</span>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded d-none" id="modal-alert-desviaciones">
                    <strong class="d-block mb-1">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Desviaciones Detectadas:
                    </strong>
                    <span id="modal-detalles-fallas"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}